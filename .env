# ============================================================
# SafeNet Nigeria — Environment Variables
# ============================================================
# HOW TO USE IN CODESPACES:
#   Go to your GitHub repo
#   → Settings → Secrets and variables → Codespaces
#   → New repository secret
#   Add each variable below as a separate secret
# ============================================================

# ── ACLED API (OAuth — email + password) ─────────────────────
# The email you registered with at acleddata.com
ACLED_EMAIL=info@safe-nigeria.com.ng

# The password you set when you clicked the ACLED activation link
ACLED_PASSWORD=your_acled_password_here

# ── DATABASE ─────────────────────────────────────────────────
# Leave blank in dev — SQLite is used automatically
# Production: paste your PostgreSQL connection string here
DATABASE_URL=

# ── ENVIRONMENT ──────────────────────────────────────────────
ENVIRONMENT=development

# ── PIPELINE SETTINGS ────────────────────────────────────────
ACLED_DAYS_BACK=90
ACLED_COUNTRY=Nigeria

# ── SMS ALERTS (Phase 3+) ────────────────────────────────────
TERMII_API_KEY=your_termii_key_here
TERMII_SENDER_ID=SafeNet

# ── SECURITY ─────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_random_secret_here

# ── LOGGING ──────────────────────────────────────────────────
LOG_LEVEL=INFO
